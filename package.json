{
  "name": "dsh-session-purge",
  "version": "0.2.0",
  "description": "彻底删除一个 DSH 会话：日志目录 + 投影缓存 + 工作区登记表（DSH 自身只提供归档）",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dsh": "0.2.0-rc.2",
      "profiles": ["web", "desktop"],
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  }
}
